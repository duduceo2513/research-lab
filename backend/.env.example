# Copy to .env (never commit it). Real environment variables always win over this file.

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me                     # required when DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1        # also used by the WebSocket origin check
ALLOW_SELF_REGISTRATION=true                    # sign-up creates TEACHER accounts
LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# SQLITE_PATH=db.sqlite3
# MEDIA_ROOT_DIR=media                          # downloaded documents are stored here

# --- LLM keys: the DB only stores these variable NAMES (LLMProvider.secret_env_name) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_API_KEY=                              # optional
LOCAL_LLM_BASE_URL=http://localhost:11434/v1    # Ollama / vLLM / LM Studio (OpenAI-compatible)
LLM_REQUEST_TIMEOUT_SECONDS=120

# --- Search sources (OpenAlex, Crossref, arXiv, Open Library, Wikipedia, Semantic Scholar need no key) ---
API_CONTACT_EMAIL=                              # "polite pool" contact for OpenAlex and Crossref
OPENALEX_API_KEY=                               # optional: higher rate limits
OPENALEX_MAILTO=
CROSSREF_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=                       # optional
GOOGLE_BOOKS_API_KEY=                           # optional
CORE_API_KEY=                                   # required for CORE
YOUTUBE_API_KEY=                                # required for YouTube
BRIGHTDATA_API_TOKEN=                           # required for Bright Data (web search)
BRIGHTDATA_SERP_ZONE=

# --- Research Lab limits (defaults shown) ---
# RESEARCH_LAB_ENABLED=true
# RESEARCH_LAB_MAX_SEARCH_QUERIES=4
# RESEARCH_LAB_MAX_RESULTS_PER_QUERY=10
# RESEARCH_LAB_MAX_DOCUMENTS=20
# RESEARCH_LAB_MAX_RUNTIME_SECONDS=1800
# RESEARCH_LAB_MAX_REVISION_CYCLES=2
# RESEARCH_LAB_MAX_LECTURE_REVISIONS=2
# RESEARCH_LAB_MAX_DOWNLOAD_MB=20
# RESEARCH_LAB_FETCH_TIMEOUT_SECONDS=20
# RESEARCH_LAB_FETCH_PER_PROVIDER=5
# RESEARCH_LAB_FETCH_USER_AGENT=ResearchLab/1.0
# RESEARCH_LAB_VALIDATION_BATCH=4
# RESEARCH_LAB_VALIDATION_EXCERPT_CHARS=6000
# RESEARCH_LAB_CONTEXT_CHARS=30000
# RESEARCH_LAB_MIN_OUTPUT_TOKENS=8192
